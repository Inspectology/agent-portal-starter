# Runtime mode. Omit or set demo for synthetic data; Spectora is optional.
PORTAL_MODE=demo
PORT=3005

# Required together only when PORTAL_MODE=live.
SPECTORA_API_KEY=
# Positive decimal company ID shown in Spectora's documented company/API context.
SPECTORA_COMPANY_ID=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
PORTAL_SIGNING_SECRET=

# Emergency fallback for the private /admin page.
# Keep a unique high-entropy value while email-code sign-in is being validated.
ADMIN_ACCESS_KEY=

# Admin email-code sign in. ADMIN_ALLOWED_EMAILS is comma-separated.
# Resend uses RESEND_API_KEY and the verified sender below.
ADMIN_ALLOWED_EMAILS=jordanbird@inspect-ology.com,jvandenelzen@inspect-ology.com,ndinsmore@inspect-ology.com
ADMIN_SECURITY_EMAIL_TO=info@inspect-ology.com
ADMIN_AUTH_EMAIL_FROM=Agent Dashboard <agent-dashboard@inspect-ology.com>
ADMIN_CODE_TTL_SECONDS=600
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_AUTH_RATE_LIMIT_MAX=5
ADMIN_AUTH_RATE_LIMIT_WINDOW_MS=600000

# Read-only Google Drive access for Spectora report backups through Vercel OIDC.
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_WORKLOAD_IDENTITY_POOL_ID=vercel
GOOGLE_WORKLOAD_IDENTITY_PROVIDER_ID=vercel
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=1upBHQJ7dzZ4rEgvAt_VRk-fxZ0fhFD0m

# Ask Inspectology AI. Keep the API key server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=60000

# Email notification when an agent requests profile changes.
# Use a verified Inspectology sender address in Resend.
RESEND_API_KEY=
PROFILE_CHANGE_EMAIL_TO=info@inspect-ology.com
PROFILE_CHANGE_EMAIL_FROM=Agent Dashboard <agent-dashboard@inspect-ology.com>

# IVY - Inspectology Virtual Operations Assistant
OPS_RESEND_API_KEY=
OPS_SPREADSHEET_ID=15zah4PYh510csoKw2BkH5p88eZmhh7qFsG1AxxdimVQ
# Signing secret from the Resend email.received webhook. Never commit the real value.
OPS_RESEND_WEBHOOK_SECRET=
# Keep false until dry-run matching has been reviewed on real vendor traffic.
OPS_AUTO_UPLOAD=false
OPS_ATTACHMENT_TYPE_TERMITE=
OPS_ATTACHMENT_TYPE_CHIMNEY=
OPS_ATTACHMENT_TYPE_WELL_WATER=water
OPS_ATTACHMENT_TYPE_SEPTIC=

# Optional canonical public origin for generated invite links.
# Vercel auto-detection is used when omitted.
PORTAL_PUBLIC_ORIGIN=

# Optional live-mode safeguards (bounded ranges are enforced).
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_MAX_BYTES=1000000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# White-label text and contact links. URL values must use HTTPS.
PORTAL_APP_NAME=Agent Portal
COMPANY_NAME=Example Home Inspections
COMPANY_TAGLINE=Example portal for confident home decisions
COMPANY_LICENSE=License HI00000
COMPANY_PHONE=(555) 014-0720
COMPANY_WEBSITE=https://example.com
BOOKING_URL=https://example.com/book
WHATSAPP_URL=https://example.com/message

# Six-digit CSS colors. Keep all text/background pairs at 4.5:1 contrast or better.
BRAND_PRIMARY_COLOR=#f5b819
BRAND_ACCENT_TEXT_COLOR=#765400
BRAND_INK_COLOR=#232323
BRAND_MUTED_COLOR=#6f6f68
BRAND_SURFACE_COLOR=#ffffff
BRAND_BACKGROUND_COLOR=#fafaf7
BRAND_BORDER_COLOR=#e6e2d9
BRAND_SUCCESS_COLOR=#208c5a
BRAND_FOCUS_COLOR=#2563eb

# Synthetic demo identity and labels.
DEMO_AGENT_FIRST_NAME=Taylor
DEMO_AGENT_LAST_NAME=Morgan
DEMO_AGENT_AGENCY=Example Realty Group
DEMO_AGENT_CITY=Sample City
DEMO_AGENT_STATE=FL
DEMO_AGENT_PHOTO_PATH=/assets/mock-agent.svg
DEMO_TIER_LABEL=Inspectology Partner
